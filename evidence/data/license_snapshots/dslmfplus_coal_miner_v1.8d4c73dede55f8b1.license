ngyao", "last_name": "Huang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1266177, "full_name": "Yuyang Li", "first_name": "Yuyang", "last_name": "Li", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 1468852, "full_name": "Dian Zhao", "first_name": "Dian", "last_name": "Zhao", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [{"name": "Research Data Support", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "Complete where RDS data are part of RDS submission"}, "field_type": "text", "order": null, "is_mandatory": false}], "figshare_url": "https://springernature.figshare.com/articles/dataset/An_open_dataset_for_intelligent_recognition_and_classification_of_abnormal_condition_in_longwall_mining/22654945", "download_disabled": false, "description": "This work developed image dataset of underground longwall mining face (DsLMF+), which consists of 138004 images with annotation 6 categories of mine personnel, hydraulic support guard plate, large coal, towline, miners\u2019 behaviour and mine safety helmet. All the labels of dataset are publicly available in YOLO format and COCO format.The dataset aims to support further research and advancement of the intelligent identification and classification of abnormal conditions for underground mining.", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 24421851538, "created_date": "2024-07-08T13:27:35Z", "modified_date": "2024-07-08T13:27:35Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tags": ["Artificial Intelligence  and image processing", "object detection", "Pattern Recognition and Data Mining", "computer vision", "Engineering", "signal processing", "Deep Learning Applications", "longwall mining", "image datasets", "fully